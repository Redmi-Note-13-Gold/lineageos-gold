+
+; Gold OS3 stock vendor + 6.6 kernel: isolate Xiaomi Power HAL boost writes.
+(type vendor_sysfs_thermal_boost)
+(roletype object_r vendor_sysfs_thermal_boost)
+(typeattributeset fs_type (vendor_sysfs_thermal_boost))
+(typeattributeset sysfs_type (vendor_sysfs_thermal_boost))
+(genfscon sysfs "/devices/virtual/thermal/thermal_message/boost" (u object_r vendor_sysfs_thermal_boost ((s0) (s0))))
+; Preserve the old sysfs_therm file permissions on this one relabeled node.
+(allow factory vendor_sysfs_thermal_boost (file (ioctl read write getattr lock append map open watch watch_reads)))
+(allow hal_thermal_default vendor_sysfs_thermal_boost (file (ioctl read write getattr lock append map open watch watch_reads)))
+(allow merged_hal_service vendor_sysfs_thermal_boost (file (ioctl read write getattr lock append map open watch watch_reads)))
+(allow mtk_hal_mbrain vendor_sysfs_thermal_boost (file (ioctl read getattr lock map open watch watch_reads)))
+(allow mtk_hal_camera vendor_sysfs_thermal_boost (file (ioctl read write getattr lock append map open watch watch_reads)))
+(allow recovery_202404 vendor_sysfs_thermal_boost (file (ioctl read getattr lock map open watch watch_reads)))
+(allow thermal_core vendor_sysfs_thermal_boost (file (ioctl read write getattr lock append map open watch watch_reads)))
+(allow thermal_manager vendor_sysfs_thermal_boost (file (write lock append map open)))
+(allow untrusted_app_25_202404 vendor_sysfs_thermal_boost (file (ioctl read getattr lock map open watch watch_reads)))
+(allow system_app_202404 vendor_sysfs_thermal_boost (file (read write getattr open watch watch_reads)))
+(allow system_server_202404 vendor_sysfs_thermal_boost (file (read)))
+(allow system_server_202404 vendor_sysfs_thermal_boost (file (watch_reads)))
+(allow mi_thermald vendor_sysfs_thermal_boost (file (ioctl read write getattr lock append map open watch watch_reads)))
+(allow mtk_hal_light vendor_sysfs_thermal_boost (file (read getattr open watch)))
+; libpowerhal set_value uses open(O_WRONLY), write, close only.
+(allow mtk_hal_power vendor_sysfs_thermal_boost (file (open write)))
