+        mIcons.addIgnoredSlot("slot0");
+        measureAndLayout(mIcons, 20 * mFrame, AT_MOST);
+        assertEquals(STATE_HIDDEN, state(mIcons.getChildAt(0)).visibleState);
+        assertEquals(7 * mFrame + 6 * mSpacing, mIcons.getMeasuredWidth());
+    }
