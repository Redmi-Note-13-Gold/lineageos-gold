+package com.android.systemui.statusbar.phone;
+
+import android.content.Context;
+import android.util.AttributeSet;
+import android.view.View;
+
+import com.android.keyguard.AlphaOptimizedLinearLayout;
+
+/** A wrap-content system icon row that reserves the battery and clock before measuring icons. */
+public class SystemIconsLayout extends AlphaOptimizedLinearLayout {
+    private int mFixedWidth;
+
+    public SystemIconsLayout(Context context, AttributeSet attrs) {
+        super(context, attrs);
+    }
+
+    @Override
+    protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
+        mFixedWidth = 0;
+        // Also handles the Compose battery inserted into this row at runtime. Icons are the
+        // only flexible child; battery/clock widths must be known before granting their budget.
+        // Identify by type: DemoStatusIcons replaces the normal container without copying its id.
+        for (int i = getChildCount() - 1; i >= 0; i--) {
+            View child = getChildAt(i);
+            if (child.getVisibility() == GONE || child instanceof StatusIconContainer) {
+                continue;
+            }
+            super.measureChildWithMargins(child, widthMeasureSpec, mFixedWidth,
+                    heightMeasureSpec, 0);
+            LayoutParams lp = (LayoutParams) child.getLayoutParams();
+            mFixedWidth += child.getMeasuredWidth() + lp.leftMargin + lp.rightMargin;
+        }
+        // No weighted children: the icon container receives AT_MOST and can return its packed
+        // width. LinearLayout then lays out that width plus the fixed children, with normal RTL,
+        // margins and vertical gravity. No ancestor needs to inspect or remeasure overflow.
+        super.onMeasure(widthMeasureSpec, heightMeasureSpec);
+    }
+
+    @Override
+    protected void measureChildWithMargins(View child, int parentWidthMeasureSpec, int widthUsed,
+            int parentHeightMeasureSpec, int heightUsed) {
+        if (child instanceof StatusIconContainer) {
+            widthUsed = mFixedWidth;
+        }
+        super.measureChildWithMargins(child, parentWidthMeasureSpec, widthUsed,
+                parentHeightMeasureSpec, heightUsed);
+    }
+}
