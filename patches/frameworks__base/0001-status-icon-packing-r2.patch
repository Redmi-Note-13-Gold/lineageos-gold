+
+package com.android.systemui.statusbar.phone;
+
+/** Chooses the same end-most icons for measurement and layout. All widths are in pixels. */
+final class StatusIconPacking {
+    private StatusIconPacking() {}
+
+    static final class Result {
+        final int iconCount;
+        final int overflowWidth;
+        final int width;
+
+        Result(int iconCount, int overflowWidth, int width) {
+            this.iconCount = iconCount;
+            this.overflowWidth = overflowWidth;
+            this.width = width;
+        }
+    }
+
+    static Result calculate(int[] widths, int maxIcons, int available, int spacing,
+            int dotFrameWidth, int dotDiameter) {
+        long naturalWidth = 0;
+        for (int width : widths) {
+            naturalWidth += width;
+        }
+        naturalWidth += (long) Math.max(0, widths.length - 1) * spacing;
+        if (widths.length <= maxIcons && naturalWidth <= available) {
+            return new Result(widths.length, 0, (int) naturalWidth);
+        }
+
+        // Keep an overflow indicator whenever its actual circle fits, even if there is
+        // insufficient room for a full icon frame. Below that size no icon can be drawn safely.
+        final int overflowWidth = available >= dotDiameter
+                ? Math.min(dotFrameWidth, available) : 0;
+        if (overflowWidth == 0) {
+            return new Result(0, 0, 0);
+        }
+        final int maxVisible = Math.min(widths.length - 1, maxIcons - 1);
+        int packedWidth = overflowWidth;
+        int visible = 0;
+        for (int i = widths.length - 1; i >= 0 && visible < maxVisible; i--) {
+            final long nextWidth = (long) packedWidth + spacing + widths[i];
+            if (nextWidth > available) {
+                break;
+            }
+            packedWidth = (int) nextWidth;
+            visible++;
+        }
+        return new Result(visible, overflowWidth, packedWidth);
+    }
+}
