+    }
+
+    private static void measureAndLayout(View view, int width, int mode) {
+        view.measure(makeMeasureSpec(width, mode), makeMeasureSpec(200, AT_MOST));
+        view.layout(0, 0, view.getMeasuredWidth(), view.getMeasuredHeight());
+    }
