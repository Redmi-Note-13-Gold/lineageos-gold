+
+// Unsupported images must return before creating any Soong modules. Embedding
+// a nil LoadHookContext makes an accidental call to CreateModule fail the test.
+type vendorRamdiskTestContext struct {
+	android.LoadHookContext
+	config android.Config
+	errors []string
+}
+
+func (c *vendorRamdiskTestContext) Config() android.Config { return c.config }
+func (c *vendorRamdiskTestContext) ModuleErrorf(format string, args ...interface{}) {
+	c.errors = append(c.errors, fmt.Sprintf(format, args...))
+}
+
+func TestVendorRamdiskFragmentBuildModes(t *testing.T) {
+	for _, kati := range []bool{false, true} {
+		for _, tc := range []struct {
+			name      string
+			fragments []string
+			supported bool
+			dlkm      bool
+		}{
+			{name: "none", supported: true},
+			{name: "dlkm", fragments: []string{"dlkm"}, supported: true, dlkm: true},
+			{name: "named_prebuilt", fragments: []string{"init_boot"}},
+			{name: "multiple", fragments: []string{"dlkm", "init_boot"}},
+		} {
+			t.Run(fmt.Sprintf("kati_%t/%s", kati, tc.name), func(t *testing.T) {
+				config := android.TestConfig(t.TempDir(), nil, "", nil)
+				if kati {
+					android.SetKatiEnabledForTests(config)
+				}
+				vars := android.PartitionVariables{
+					BoardVendorRamdiskFragments:  tc.fragments,
+					BoardBootHeaderVersion:       "4",
+					BuildingDebugVendorBootImage: true,
+				}
+				config.TestProductVariables.PartitionVarsForSoongMigrationOnlyDoNotUse = vars
+				ctx := &vendorRamdiskTestContext{config: config}
+				if got := vendorRamdiskFragmentsSupported(vars); got != tc.supported {
+					t.Fatalf("support = %t, want %t", got, tc.supported)
+				}
+				if got := buildingVendorRamdiskFragmentDlkm(ctx, vars); got != tc.dlkm {
+					t.Errorf("dlkm enabled = %t, want %t", got, tc.dlkm)
+				}
+				wantError := !kati && !tc.supported
+				if gotError := len(ctx.errors) != 0; gotError != wantError {
+					t.Errorf("errors = %v, want error: %t", ctx.errors, wantError)
+				}
+				if !tc.supported {
+					creator := &filesystemCreator{}
+					creator.createVendorBootImages(ctx, dtbImg{})
+					if creator.properties.Vendor_boot_image != "" || creator.properties.Vendor_boot_debug_image != "" || creator.properties.Vendor_boot_test_harness_image != "" {
+						t.Error("unsupported layout registered a partial vendor_boot image")
+					}
+					wantUnsupported := []string{"vendor_boot", "vendor_boot-debug", "vendor_boot-test-harness"}
+					android.AssertDeepEquals(t, "unsupported vendor_boot images", wantUnsupported, creator.properties.Unsupported_partition_types)
+					for _, create := range []func(android.LoadHookContext, dtbImg) bool{
+						createVendorBootImage,
+						createVendorBootDebugImage,
+						createVendorBootTestHarnessImage,
+					} {
+						if create(ctx, dtbImg{}) {
+							t.Error("unsupported layout created a partial vendor_boot image")
+						}
+					}
+				}
+			})
+		}
+	}
+}
