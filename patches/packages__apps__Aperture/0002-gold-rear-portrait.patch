diff --git a/app/src/main/java/org/lineageos/aperture/utils/GoldPortraitCapture.kt b/app/src/main/java/org/lineageos/aperture/utils/GoldPortraitCapture.kt
new file mode 100644
index 0000000..696b4d3
--- /dev/null
+++ b/app/src/main/java/org/lineageos/aperture/utils/GoldPortraitCapture.kt
@@ -0,0 +1,387 @@
+// SPDX-License-Identifier: Apache-2.0
+package org.lineageos.aperture.utils
+
+import android.content.Context
+import android.graphics.ImageFormat
+import android.graphics.Rect
+import android.graphics.YuvImage
+import android.hardware.camera2.*
+import android.hardware.camera2.params.OutputConfiguration
+import android.hardware.camera2.params.SessionConfiguration
+import android.media.Image
+import android.media.ImageReader
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemProperties
+import android.util.Size
+import androidx.camera.core.ImageCapture
+import androidx.exifinterface.media.ExifInterface
+import androidx.preference.PreferenceManager
+import com.xiaomi.engine.*
+import kotlinx.coroutines.*
+import java.io.ByteArrayOutputStream
+import java.util.concurrent.Executor
+import java.util.concurrent.Executors
+import java.util.concurrent.atomic.AtomicBoolean
+
+/** Single-shot Gold rear portrait. Ordinary preview and CameraX remain the default. */
+object GoldPortraitCapture {
+    const val PREFERENCE = "gold_dual_portrait"
+    private val busy = AtomicBoolean(false)
+    @Volatile private var active: Capture? = null
+    private val role = CameraCharacteristics.Key("com.xiaomi.cameraid.role.cameraId", Int::class.javaObjectType)
+    private val fNumber = CaptureRequest.Key("xiaomi.bokeh.fNumberApplied", String::class.java)
+    private val single = CaptureRequest.Key("xiaomi.bokeh.enabled", Boolean::class.javaObjectType)
+    private val dual = CaptureRequest.Key("xiaomi.bokehrear.enabled", Boolean::class.javaObjectType)
+    private data class Plan(val main: Size, val sub: Size, val depth: Size, val info: CameraCharacteristics)
+
+    fun isEnabled(context: Context) = PreferenceManager.getDefaultSharedPreferences(context)
+        .getBoolean(PREFERENCE, false)
+    fun isSupported(context: Context) = runCatching { plan(context); true }.getOrDefault(false)
+
+    private fun plan(context: Context): Plan {
+        check(Build.DEVICE == "gold")
+        val manager = context.getSystemService(CameraManager::class.java)
+        val info = manager.getCameraCharacteristics("3")
+        check(info[role] == 61 && info.physicalCameraIds == setOf("0", "2"))
+        check(info.availableCaptureRequestKeys.any { it.name == fNumber.name })
+        fun ints(name: String): IntArray? = if (info.keys.any { it.name == name })
+            info[CameraCharacteristics.Key(name, IntArray::class.java)] else null
+        fun optimal(name: String): Size? = ints(name)
+            ?.takeIf { it.size >= 6 && it[0] > 0 && it[1] > 0 }
+            ?.let { Size(it[0], it[1]) } // Stock 4:3 is the first width/height pair.
+        fun largest(characteristics: CameraCharacteristics, limit: Size? = null): Size =
+            requireNotNull(characteristics[CameraCharacteristics.SCALER_STREAM_CONFIGURATION_MAP])
+                .getOutputSizes(ImageFormat.YUV_420_888)
+                .filter { it.width.toLong() * 3 == it.height.toLong() * 4 &&
+                    (limit == null || it.width.toLong() * it.height <= limit.width.toLong() * limit.height) }
+                .maxByOrNull { it.width.toLong() * it.height } ?: error("No 4:3 portrait stream")
+        val main = optimal("xiaomi.camera.bokehinfo.masterOptimalSize") ?: largest(info)
+        val sub = optimal("xiaomi.camera.bokehinfo.slaveOptimalSize")
+            ?: largest(manager.getCameraCharacteristics("2"), main)
+        check(main.width.toLong() * 3 == main.height.toLong() * 4 &&
+            sub.width.toLong() * 3 == sub.height.toLong() * 4)
+        val dimensions = ints("com.xiaomi.camera.supportedfeatures.bokehDepthBufferSize")
+        val explicitDepth = dimensions?.takeIf { it.size >= 2 && it[0] > 0 && it[1] > 0 }
+            ?.let { Size(it[0], it[1]) }
+        val vendor = info[CameraCharacteristics.Key(
+            "com.xiaomi.camera.supportedfeatures.bokehVendorID", Int::class.javaObjectType)]
+        val scale = SystemProperties.getInt("persist.mibokeh.depth.scale", 1)
+        check(scale > 0)
+        val divisor = if (vendor == 2) 2 else 1
+        val depth = explicitDepth ?: Size(Math.multiplyExact(main.width / divisor, scale),
+            Math.multiplyExact(main.height / divisor, scale))
+        check(depth.width > 0 && depth.height > 0)
+        return Plan(main, sub, depth, info)
+    }
+
+    suspend fun capture(context: Context, executor: Executor, cameraId: String,
+        deviceOrientationDegrees: Int, output: ImageCapture.OutputFileOptions,
+        onCaptureStarted: () -> Unit): ImageCapture.OutputFileResults {
+        check(cameraId == "0" && deviceOrientationDegrees in setOf(0, 90, 180, 270))
+        check(busy.compareAndSet(false, true)) { "Portrait processing is still closing" }
+        val run = try { Capture(context, executor, plan(context), onCaptureStarted) }
+            catch (error: Throwable) { busy.set(false); throw error }
+        active = run
+        val bytes = try {
+            run.start()
+            withTimeoutOrNull(25_000) { run.result.await() }
+                ?: throw IllegalStateException("Portrait capture timed out")
+        } finally {
+            executor.execute { run.close() }
+            withContext(NonCancellable) {
+                try { withTimeout(5_000) { run.closed.await(); run.engineClosed.await() } }
+                catch (_: TimeoutCancellationException) {
+                    // Keep the owner and input buffers alive until native teardown actually returns.
+                    // Do not rebind CameraX or admit another native capture meanwhile.
+                    throw GoldHighResolutionCapture.CameraCloseTimeoutException()
+                }
+            }
+        }
+        val rotation = (requireNotNull(run.plan.info[CameraCharacteristics.SENSOR_ORIENTATION]) +
+            deviceOrientationDegrees) % 360
+        return withContext(Dispatchers.IO) {
+            val file = java.io.File.createTempFile("portrait-", ".jpg", context.cacheDir)
+            try {
+                file.writeBytes(bytes)
+                ExifInterface(file).apply {
+                    setAttribute(ExifInterface.TAG_ORIENTATION, when (rotation) {
+                        90 -> ExifInterface.ORIENTATION_ROTATE_90
+                        180 -> ExifInterface.ORIENTATION_ROTATE_180
+                        270 -> ExifInterface.ORIENTATION_ROTATE_270
+                        else -> ExifInterface.ORIENTATION_NORMAL
+                    }.toString())
+                    output.metadata.location?.let { setGpsInfo(it) }
+                    saveAttributes()
+                }
+                GoldHighResolutionCapture.saveJpeg(file.readBytes(), output)
+            } finally { file.delete() }
+        }
+    }
+
+    private class Capture(val context: Context, val executor: Executor, val plan: Plan,
+        val onCaptureStarted: () -> Unit) {
+        val result = CompletableDeferred<ByteArray>()
+        val closed = CompletableDeferred<Unit>()
+        val engineClosed = CompletableDeferred<Unit>()
+        private val manager = context.getSystemService(CameraManager::class.java)
+        private val handler = Handler(Looper.getMainLooper())
+        private val worker = Executors.newSingleThreadExecutor()
+        private val readers = mutableListOf<ImageReader>()
+        private val frames = mutableListOf<FrameData>()
+        private val inputs = arrayOfNulls<Image>(2)
+        private var metadata: TotalCaptureResult? = null
+        private var device: CameraDevice? = null
+        private var session: CameraCaptureSession? = null
+        private var availability: CameraManager.AvailabilityCallback? = null
+        private var openRequested = false
+        private var finished = false
+        private var submitted = false
+        private var capturing = false
+        private var previewFrames = 0
+        // Engine state is accessed only on worker; callbacks post back to the serial main executor.
+        private var initialized = false
+        private var createSessionAttempted = false
+        private var handle = 0L
+        private val status = TaskSession.SessionStatusCallback { code, _, _ ->
+            // Stock eh.t$a: 2=session died, 20=post-processing error; other codes are data events.
+            if (code == 2 || code == 20) executor.execute {
+                fail(IllegalStateException("Portrait processing error $code"))
+            }
+        }
+        private val frameStatus = TaskSession.FrameCallback { _, _, _ -> }
+
+        private fun reader(size: Size, format: Int) = ImageReader.newInstance(size.width, size.height,
+            format, 3).also { readers.add(it) }
+        private fun fail(error: Throwable) {
+            if (!finished) result.completeExceptionally(IllegalStateException("Portrait capture failed", error))
+            close()
+        }
+        fun start() = executor.execute {
+            try {
+                val main = reader(plan.main, ImageFormat.YUV_420_888)
+                val sub = reader(plan.sub, ImageFormat.YUV_420_888)
+                val previewSize = requireNotNull(plan.info[CameraCharacteristics.SCALER_STREAM_CONFIGURATION_MAP])
+                    .getOutputSizes(ImageFormat.YUV_420_888).filter { it.width <= 1440 && it.height <= 1080 }
+                    .maxByOrNull { it.width * it.height } ?: error("No portrait preview stream")
+                val preview = reader(previewSize, ImageFormat.YUV_420_888)
+                preview.setOnImageAvailableListener({
+                    if (!finished) try { it.acquireLatestImage()?.close() }
+                    catch (error: Throwable) { fail(error) }
+                }, handler)
+                listOf(main, sub).forEachIndexed { index, r ->
+                    r.setOnImageAvailableListener({
+                        if (!finished) try {
+                            val image = it.acquireNextImage() ?: return@setOnImageAvailableListener
+                            if (submitted || inputs[index] != null) image.close()
+                            else { inputs[index] = image; submit() }
+                        } catch (error: Throwable) { fail(error) }
+                    }, handler)
+                }
+                val effect = reader(plan.main, ImageFormat.YUV_420_888)
+                val original = reader(plan.main, ImageFormat.YUV_420_888)
+                val depth = reader(plan.depth, 0x20365931)
+                listOf(original, depth).forEach { r ->
+                    r.setOnImageAvailableListener({
+                        if (!finished) try { it.acquireNextImage()?.close() }
+                        catch (error: Throwable) { fail(error) }
+                    }, handler)
+                }
+                effect.setOnImageAvailableListener({
+                    if (!finished) try {
+                        val image = it.acquireNextImage() ?: return@setOnImageAvailableListener
+                        val timestamp = metadata?.get(CaptureResult.SENSOR_TIMESTAMP)
+                        if (!submitted || image.timestamp != timestamp) {
+                            image.close(); error("Unexpected portrait output timestamp")
+                        }
+                        // Copy before teardown; conversion handles each plane's own strides.
+                        val nv21 = image.use { toNv21(it) }
+                        worker.execute {
+                            try {
+                                val bytes = ByteArrayOutputStream().use { out ->
+                                    check(YuvImage(nv21, ImageFormat.NV21, plan.main.width,
+                                        plan.main.height, null).compressToJpeg(
+                                        Rect(0, 0, plan.main.width, plan.main.height), 95, out))
+                                    out.toByteArray()
+                                }
+                                executor.execute { if (!finished) result.complete(bytes); close() }
+                            } catch (error: Throwable) { executor.execute { fail(error) } }
+                        }
+                    } catch (error: Throwable) { fail(error) }
+                }, handler)
+                val outputs = listOf(effect, original, depth).mapIndexed { group, r -> OutputConfiguration(group, r.surface) }
+                worker.execute {
+                    try {
+                        MiCamAlgoInterfaceJNI.load()
+                        initialized = true // Attempt deInit even after a partially failed init.
+                        check(MiCamAlgoInterfaceJNI.init(context.filesDir.absolutePath) == 0)
+                        val format = BufferFormat(plan.main.width, plan.main.height, ImageFormat.YUV_420_888,
+                            GraphDescriptorBean(0x280, 2, true, 0x301)).apply { setDepthBufferSize(plan.depth) }
+                        createSessionAttempted = true
+                        handle = MiCamAlgoInterfaceJNI.createSessionByOutputConfigurations(format, outputs, status)
+                        check(handle != 0L)
+                        executor.execute { if (!finished) open(main, sub, preview) }
+                    } catch (error: Throwable) { executor.execute { fail(error) } }
+                }
+            } catch (error: Throwable) { fail(error) }
+        }
+
+        private fun applyBokeh(request: CaptureRequest.Builder) {
+            val names = plan.info.availableCaptureRequestKeys.map { it.name }.toSet()
+            request.set(fNumber, "4.0")
+            if (single.name in names) request.set(single, false)
+            if (dual.name in names) request.set(dual, true)
+            request.set(CaptureRequest.CONTROL_AF_MODE, CaptureRequest.CONTROL_AF_MODE_CONTINUOUS_PICTURE)
+            request.set(CaptureRequest.FLASH_MODE, CaptureRequest.FLASH_MODE_OFF)
+        }
+        private fun open(main: ImageReader, sub: ImageReader, preview: ImageReader) {
+            val callback = object : CameraDevice.StateCallback() {
+                override fun onOpened(camera: CameraDevice) {
+                    device = camera
+                    if (finished) { camera.close(); return }
+                    try {
+                        val outputs = listOf(OutputConfiguration(preview.surface),
+                            OutputConfiguration(main.surface).apply { setPhysicalCameraId("0") },
+                            OutputConfiguration(sub.surface).apply { setPhysicalCameraId("2") })
+                        camera.createCaptureSession(SessionConfiguration(0x9000, outputs, executor,
+                            object : CameraCaptureSession.StateCallback() {
+                                override fun onConfigured(value: CameraCaptureSession) {
+                                    if (finished) { value.close(); return }
+                                    session = value
+                                    try {
+                                        val request = camera.createCaptureRequest(CameraDevice.TEMPLATE_PREVIEW).apply {
+                                            addTarget(preview.surface); applyBokeh(this)
+                                        }
+                                        value.setSingleRepeatingRequest(request.build(), executor,
+                                            object : CameraCaptureSession.CaptureCallback() {
+                                                override fun onCaptureCompleted(s: CameraCaptureSession, r: CaptureRequest, m: TotalCaptureResult) {
+                                                    if (finished || capturing) return
+                                                    previewFrames++
+                                                    if (previewFrames < 3 || (previewFrames < 30 &&
+                                                        (m[CaptureResult.CONTROL_AE_STATE] == CaptureResult.CONTROL_AE_STATE_SEARCHING ||
+                                                         m[CaptureResult.CONTROL_AF_STATE] == CaptureResult.CONTROL_AF_STATE_PASSIVE_SCAN))) return
+                                                    capturing = true
+                                                    try {
+                                                        val still = camera.createCaptureRequest(CameraDevice.TEMPLATE_STILL_CAPTURE).apply {
+                                                            addTarget(main.surface); addTarget(sub.surface); applyBokeh(this)
+                                                        }.build()
+                                                        value.captureSingleRequest(still, executor,
+                                                            object : CameraCaptureSession.CaptureCallback() {
+                                                                override fun onCaptureStarted(s: CameraCaptureSession, r: CaptureRequest, t: Long, n: Long) = onCaptureStarted()
+                                                                override fun onCaptureCompleted(s: CameraCaptureSession, r: CaptureRequest, m: TotalCaptureResult) {
+                                                                    if (!finished) try { metadata = m; submit() } catch (error: Throwable) { fail(error) }
+                                                                }
+                                                                override fun onCaptureFailed(s: CameraCaptureSession, r: CaptureRequest, f: CaptureFailure) = fail(IllegalStateException("Portrait frame rejected"))
+                                                            })
+                                                    } catch (error: Throwable) { fail(error) }
+                                                }
+                                            })
+                                    } catch (error: Throwable) { fail(error) }
+                                }
+                                override fun onConfigureFailed(value: CameraCaptureSession) {
+                                    value.close(); fail(IllegalStateException("Portrait session rejected"))
+                                }
+                            }))
+                    } catch (error: Throwable) { fail(error) }
+                }
+                override fun onDisconnected(camera: CameraDevice) { device = camera; camera.close(); fail(IllegalStateException("Portrait disconnected")) }
+                override fun onError(camera: CameraDevice, error: Int) { device = camera; camera.close(); fail(IllegalStateException("Portrait camera error $error")) }
+                override fun onClosed(camera: CameraDevice) { closed.complete(Unit) }
+            }
+            val available = mutableSetOf<String>()
+            availability = object : CameraManager.AvailabilityCallback() {
+                override fun onCameraAvailable(id: String) {
+                    available.add(id)
+                    if (!available.containsAll(listOf("0", "3")) || finished || openRequested) return
+                    manager.unregisterAvailabilityCallback(this)
+                    try { openRequested = true; manager.openCamera("3", executor, callback) }
+                    catch (error: Throwable) { closed.complete(Unit); fail(error) }
+                }
+                override fun onCameraUnavailable(id: String) { available.remove(id) }
+            }
+            manager.registerAvailabilityCallback(executor, requireNotNull(availability))
+        }
+
+        private fun submit() {
+            if (submitted || finished) return
+            val m = metadata ?: return
+            val a = inputs[0] ?: return
+            val b = inputs[1] ?: return
+            val timestamp = requireNotNull(m[CaptureResult.SENSOR_TIMESTAMP])
+            check(a.timestamp == timestamp && b.timestamp == timestamp) { "Unsynchronized portrait inputs" }
+            val physical = listOf("0", "2").map { requireNotNull(m.physicalCameraResults[it]) }
+            val requestMetadata = m.request.nativeCopy
+            listOf(a, b).forEachIndexed { index, image ->
+                frames.add(FrameData(index, m.sequenceId, m.frameNumber, m.nativeCopy,
+                    requestMetadata, image).apply { setPhysicalResultMetadata(physical[index].nativeCopy) })
+            }
+            inputs.fill(null)
+            submitted = true
+            worker.execute {
+                try {
+                    for (frame in frames) check(MiCamAlgoInterfaceJNI.processFrame(handle, frame, frameStatus) == 0)
+                } catch (error: Throwable) { executor.execute { fail(error) } }
+            }
+        }
+        fun close() {
+            if (finished) return
+            finished = true
+            availability?.let { runCatching { manager.unregisterAvailabilityCallback(it) } }
+            runCatching { session?.close() }; runCatching { device?.close() }
+            if (!openRequested) closed.complete(Unit)
+            inputs.forEach { it?.close() }; inputs.fill(null)
+            // Serialized behind init/create/submit. Never release buffers still owned by native code.
+            worker.execute {
+                try {
+                    if (handle != 0L) {
+                        check(MiCamAlgoInterfaceJNI.flush(handle) == 0)
+                        check(MiCamAlgoInterfaceJNI.destroySession(handle) == 0)
+                        handle = 0L
+                    }
+                    frames.forEach { it.release() }
+                    var nativeReusable = true
+                    if (initialized) try {
+                        check(MiCamAlgoInterfaceJNI.deInit() == 0)
+                    } catch (error: Throwable) {
+                        if (createSessionAttempted) throw error
+                        // Init failed before any output surface or input buffer reached native.
+                        // Isolate only portrait reentry; local cleanup must not block CameraX.
+                        nativeReusable = false
+                        android.util.Log.e("GoldPortraitCapture", "Portrait initialization cleanup failed", error)
+                    }
+                    executor.execute {
+                        readers.forEach { it.close() }
+                        engineClosed.complete(Unit)
+                        closed.invokeOnCompletion {
+                            active = null
+                            if (nativeReusable) busy.set(false)
+                        }
+                        worker.shutdown()
+                    }
+                } catch (error: Throwable) {
+                    android.util.Log.e("GoldPortraitCapture", "Native teardown was not confirmed", error)
+                    // Native ownership is uncertain. Retain the owner/buffers and reject new work;
+                    // caller times out instead of rebinding over an unconfirmed teardown.
+                }
+            }
+        }
+    }
+
+    private fun toNv21(image: Image): ByteArray {
+        check(image.format == ImageFormat.YUV_420_888 && image.cropRect == Rect(0, 0, image.width, image.height))
+        val w = image.width; val h = image.height
+        val bytes = ByteArray(w * h * 3 / 2)
+        image.planes.forEachIndexed { index, plane ->
+            val width = if (index == 0) w else w / 2
+            val height = if (index == 0) h else h / 2
+            val buffer = plane.buffer.duplicate()
+            val start = buffer.position()
+            for (y in 0 until height) for (x in 0 until width) {
+                val offset = if (index == 0) y * w + x else w * h + y * w + 2 * x + if (index == 2) 0 else 1
+                bytes[offset] = buffer.get(start + y * plane.rowStride + x * plane.pixelStride)
+            }
+        }
+        return bytes
+    }
+}
