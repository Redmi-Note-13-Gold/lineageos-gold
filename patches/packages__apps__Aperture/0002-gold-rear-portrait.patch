@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: Apache-2.0
+package com.xiaomi.engine
+
+import android.media.Image
+import android.os.Parcel
+import android.os.Parcelable
+import android.util.Size
+
+/** Names and descriptors are the stock JNI ABI, not an alternative camera framework. */
+class GraphDescriptorBean(private var mOperationModeID: Int, private var mStreamNumber: Int,
+    private var mIsSnapshot: Boolean, private var mCameraCombinationMode: Int) : Parcelable {
+    fun getOperationModeID() = mOperationModeID
+    fun getStreamNumber() = mStreamNumber
+    fun isSnapshot() = mIsSnapshot
+    fun getCameraCombinationMode() = mCameraCombinationMode
+    override fun describeContents() = 0
+    override fun writeToParcel(p: Parcel, flags: Int) {
+        p.writeInt(mOperationModeID); p.writeInt(mStreamNumber)
+        p.writeByte(if (mIsSnapshot) 1.toByte() else 0.toByte()); p.writeInt(mCameraCombinationMode)
+    }
+    companion object {
+        @JvmField val CREATOR = object : Parcelable.Creator<GraphDescriptorBean> {
+            override fun createFromParcel(p: Parcel) = GraphDescriptorBean(p.readInt(), p.readInt(), p.readByte().toInt() != 0, p.readInt())
+            override fun newArray(size: Int) = arrayOfNulls<GraphDescriptorBean>(size)
+        }
+    }
+}
+class BufferFormat(private var mBufferWidth: Int, private var mBufferHeight: Int,
+    private var mBufferFormat: Int, private var mGraphDescriptor: GraphDescriptorBean) : Parcelable {
+    private var mDepthBufferSize: Size? = null
+    fun getBufferWidth() = mBufferWidth
+    fun getBufferHeight() = mBufferHeight
+    fun getBufferFormat() = mBufferFormat
+    fun getGraphDescriptor() = mGraphDescriptor
+    fun getCameraCombinationMode() = mGraphDescriptor.getCameraCombinationMode()
+    fun getDepthBufferSize() = mDepthBufferSize
+    fun setDepthBufferSize(size: Size) { mDepthBufferSize = size }
+    override fun describeContents() = 0
+    override fun writeToParcel(p: Parcel, flags: Int) {
+        p.writeInt(mBufferWidth); p.writeInt(mBufferHeight); p.writeInt(mBufferFormat)
+        p.writeParcelable(mGraphDescriptor, flags)
+        p.writeByte(if (mDepthBufferSize != null) 2.toByte() else 0.toByte())
+        mDepthBufferSize?.let { p.writeInt(it.width); p.writeInt(it.height) }
+    }
+    companion object {
+        @JvmField val CREATOR = object : Parcelable.Creator<BufferFormat> {
+            override fun createFromParcel(p: Parcel): BufferFormat {
+                val value = BufferFormat(p.readInt(), p.readInt(), p.readInt(),
+                    requireNotNull(p.readParcelable(GraphDescriptorBean::class.java.classLoader, GraphDescriptorBean::class.java)))
+                if (p.readByte().toInt() == 2) value.setDepthBufferSize(Size(p.readInt(), p.readInt()))
+                return value
+            }
+            override fun newArray(size: Int) = arrayOfNulls<BufferFormat>(size)
+        }
+    }
+}
+class FrameData(private var mImageFlag: Int, private var mSequenceId: Int, private var mFrameNumber: Long,
+    private var mCaptureResultMetadataNative: Parcelable, private var mCaptureRequestMetadataNative: Parcelable,
+    private var mBufferImage: Image?) {
+    private var mPhysicalResultMetadataNative: Parcelable? = null
+    private var mFrameStatusCallback: FrameStatusCallback? = null
+    fun getImageFlag() = mImageFlag
+    fun getSequenceId() = mSequenceId
+    fun getFrameNumber() = mFrameNumber
+    fun getCaptureResultMetaDataNative() = mCaptureResultMetadataNative
+    fun getCaptureRequestMetaDataNative() = mCaptureRequestMetadataNative
+    fun getPhysicalResultMetadata() = mPhysicalResultMetadataNative
+    fun setPhysicalResultMetadata(value: Parcelable) { mPhysicalResultMetadataNative = value }
+    fun getBufferImage() = mBufferImage
+    fun getFrameCallback() = mFrameStatusCallback
+    fun setFrameCallback(value: FrameStatusCallback) { mFrameStatusCallback = value }
+    @Synchronized fun release() {
+        val image = mBufferImage ?: return
+        mBufferImage = null
+        image.close()
+        mFrameStatusCallback?.onFrameImageClosed(image)
+    }
+    fun interface FrameStatusCallback { fun onFrameImageClosed(image: Image) }
+}
+class TaskSession private constructor() {
+    fun interface FrameCallback { fun onFrameProcessed(code: Int, message: String?, data: Any?) }
+    fun interface SessionStatusCallback { fun onSessionCallback(code: Int, message: String?, data: Any?) }
+}
+// Kept for the native method table even though the single-shot backend never calls preProcess.
+class PreProcessData(private var mCameraId: Int, private var mWidth: Int, private var mHeight: Int,
+    private var mFormat: Int, private var mCaptureRequestMetadataNative: Parcelable) {
+    fun getCameraId() = mCameraId
+    fun getWidth() = mWidth
+    fun getHeight() = mHeight
+    fun getFormat() = mFormat
+    fun getCaptureRequestMetaDataNative() = mCaptureRequestMetadataNative
+}
+object MiCamAlgoInterfaceJNI {
+    // Load is explicit so an absent/incompatible library cannot break ordinary CameraX startup.
+    fun load() { System.loadLibrary("camera_algoup_jni.xiaomi") }
+    @JvmStatic external fun init(path: String): Int
+    @JvmStatic external fun deInit(): Int
+    @JvmStatic external fun createSessionByOutputConfigurations(format: BufferFormat, outputs: List<android.hardware.camera2.params.OutputConfiguration>, callback: TaskSession.SessionStatusCallback): Long
+    @JvmStatic external fun createSessionWithSurfaces(format: BufferFormat, outputs: List<android.view.Surface>, callback: TaskSession.SessionStatusCallback): Long
+    @JvmStatic external fun processFrame(handle: Long, frame: FrameData, callback: TaskSession.FrameCallback): Int
+    @JvmStatic external fun destroySession(handle: Long): Int
+    @JvmStatic external fun flush(handle: Long): Int
+    @JvmStatic external fun getVersionCode(): Int
+    @JvmStatic external fun dumpGcov()
+    @JvmStatic external fun preProcess(handle: Long, data: PreProcessData): Int
+    @JvmStatic external fun processFrameWithSync(handle: Long, frames: List<FrameData>, image: Image, type: Int): Int
+    @JvmStatic external fun quickFinish(handle: Long, timestamp: Long, needImage: Boolean): Int
+    @JvmStatic external fun setMiViInfo(info: String): Int
+}
+
+// Native session callbacks construct this stock data carrier, including on error paths.
+class ResultData {
+    private var mCropRegion: IntArray? = null
+    private var mFlawResult = 0
+    private var mMetadata: Map<Any, Any>? = null
+    private var mResultId = 0
+    private var mTimeStamp = 0L
+    fun getCropRegion() = mCropRegion
+    fun setCropRegion(value: IntArray?) { mCropRegion = value }
+    fun getFlawResult() = mFlawResult
+    fun setFlawResult(value: Int) { mFlawResult = value }
+    fun getMetaResult() = mMetadata
+    fun setMetaResult(value: java.util.HashMap<Any, Any>?) { mMetadata = value }
+    fun getResultId() = mResultId
+    fun setResultId(value: Int) { mResultId = value }
+    fun getTimeStamp() = mTimeStamp
+    fun setTimeStamp(value: Long) { mTimeStamp = value }
+}
