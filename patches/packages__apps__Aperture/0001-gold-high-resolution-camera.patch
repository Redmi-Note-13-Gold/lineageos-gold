+++ b/app/src/main/java/org/lineageos/aperture/utils/GoldHighResolutionCapture.kt
@@ -0,0 +1,266 @@
+/*
+ * SPDX-FileCopyrightText: 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package org.lineageos.aperture.utils
+
+import android.content.ContentValues
+import android.content.Context
+import android.graphics.BitmapFactory
+import android.graphics.ImageFormat
+import android.hardware.camera2.CameraCaptureSession
+import android.hardware.camera2.CameraCharacteristics
+import android.hardware.camera2.CameraDevice
+import android.hardware.camera2.CameraManager
+import android.hardware.camera2.CaptureFailure
+import android.hardware.camera2.CaptureRequest
+import android.hardware.camera2.CaptureResult
+import android.hardware.camera2.TotalCaptureResult
+import android.hardware.camera2.params.OutputConfiguration
+import android.hardware.camera2.params.SessionConfiguration
+import android.media.ImageReader
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.provider.MediaStore
+import androidx.camera.core.ImageCapture
+import androidx.preference.PreferenceManager
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.TimeoutCancellationException
+import kotlinx.coroutines.suspendCancellableCoroutine
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeout
+import java.util.concurrent.Executor
+import kotlin.coroutines.resume
+import kotlin.coroutines.resumeWithException
+
+/** Gold's opt-in private HAL path. Never changes the ordinary CameraX stream map. */
+object GoldHighResolutionCapture {
+    class CameraCloseTimeoutException : IllegalStateException("Camera close timed out")
+
+    const val PREFERENCE = "gold_high_resolution"
+    private const val WIDTH = 12000
+    private const val HEIGHT = 9000
+    // Matched stock MiuiCamera's SESSION_OPERATION_MODE_ALGO_UP_HD.
+    private const val SESSION_HD = 0x9004
+    private val STREAMS = CameraCharacteristics.Key(
+        "com.xiaomi.scaler.availableSuperResolutionStreamConfigurations", IntArray::class.java
+    )
+    private val REMOSAIC = CaptureRequest.Key("xiaomi.remosaic.enabled", Boolean::class.javaObjectType)
+    private val REMOSAIC_HINT = CaptureRequest.Key(
+        "com.mediatek.control.capture.remosaicenable", IntArray::class.java
+    )
+
+    fun isEnabled(context: Context) = PreferenceManager.getDefaultSharedPreferences(context)
+        .getBoolean(PREFERENCE, false)
+
+    fun isSupported(context: Context, cameraId: String = "0"): Boolean = runCatching {
+        if (Build.DEVICE != "gold" || cameraId != "0") return@runCatching false
+        val info = context.getSystemService(CameraManager::class.java)
+            .getCameraCharacteristics(cameraId)
+        val streams = info[STREAMS]?.toList()?.chunked(4) ?: return@runCatching false
+        info[CameraCharacteristics.LENS_FACING] == CameraCharacteristics.LENS_FACING_BACK &&
+            // The private table uses HAL formats: BLOB=33, not public JPEG=256.
+            streams.contains(listOf(33, WIDTH, HEIGHT, 0)) &&
+            streams.contains(listOf(ImageFormat.YUV_420_888, 1440, 1080, 0)) &&
+            listOf(REMOSAIC.name, REMOSAIC_HINT.name).all { name ->
+                info.availableCaptureRequestKeys.any { it.name == name }
+            }
+    }.getOrDefault(false)
+
+    /** The caller must unbind CameraX first and restore it after this returns, even on failure. */
+    suspend fun capture(
+        context: Context,
+        executor: Executor,
+        orientation: Int,
+        output: ImageCapture.OutputFileOptions,
+        onCaptureStarted: () -> Unit,
+    ): ImageCapture.OutputFileResults {
+        val closed = CompletableDeferred<Unit>()
+        val data = try {
+            withTimeout(20_000) {
+                suspendCancellableCoroutine<ByteArray> { continuation ->
+                    // All device/session state is confined to this serial executor.
+                    executor.execute {
+                        val manager = context.getSystemService(CameraManager::class.java)
+                        var availability: CameraManager.AvailabilityCallback? = null
+                        var openRequested = false
+                        var camera: CameraDevice? = null
+                        var session: CameraCaptureSession? = null
+                        var jpeg: ImageReader? = null
+                        var preview: ImageReader? = null
+                        var finished = false
+                        var capturing = false
+                        var frames = 0
+                        fun release() {
+                            if (finished) return
+                            finished = true
+                            availability?.let { manager.unregisterAvailabilityCallback(it) }
+                            if (!openRequested) closed.complete(Unit)
+                            session?.close()
+                            camera?.close()
+                            jpeg?.close()
+                            preview?.close()
+                        }
+                        fun fail(error: Exception) {
+                            release()
+                            if (continuation.isActive) continuation.resumeWithException(error)
+                        }
+                        continuation.invokeOnCancellation { executor.execute { release() } }
+                        if (!continuation.isActive) {
+                            closed.complete(Unit)
+                            return@execute
+                        }
+                        try {
+                            val info = manager.getCameraCharacteristics("0")
+                            jpeg = ImageReader.newInstance(WIDTH, HEIGHT, ImageFormat.JPEG, 2)
+                            preview = ImageReader.newInstance(1440, 1080, ImageFormat.YUV_420_888, 2)
+                            val handler = Handler(Looper.getMainLooper())
+                            preview!!.setOnImageAvailableListener({ reader ->
+                                executor.execute {
+                                    if (!finished) runCatching { reader.acquireLatestImage()?.close() }
+                                }
+                            }, handler)
+                            jpeg!!.setOnImageAvailableListener({ reader ->
+                                executor.execute {
+                                    if (!finished) try {
+                                        val bytes = reader.acquireNextImage()?.use { image ->
+                                            val buffer = image.planes[0].buffer
+                                            ByteArray(buffer.remaining()).also { buffer.get(it) }
+                                        } ?: return@execute
+                                        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+                                        BitmapFactory.decodeByteArray(bytes, 0, bytes.size, bounds)
+                                        check(setOf(bounds.outWidth, bounds.outHeight) == setOf(WIDTH, HEIGHT)) {
+                                            "Camera did not return a full-resolution JPEG"
+                                        }
+                                        release()
+                                        if (continuation.isActive) continuation.resume(bytes)
+                                    } catch (error: Exception) { fail(error) }
+                                }
+                            }, handler)
+                            val deviceCallback = object : CameraDevice.StateCallback() {
+                                override fun onOpened(device: CameraDevice) {
+                                    camera = device
+                                    if (finished || !continuation.isActive) { device.close(); return }
+                                    try {
+                                        val callback = object : CameraCaptureSession.StateCallback() {
+                                            override fun onConfigured(configured: CameraCaptureSession) {
+                                                if (finished) { configured.close(); return }
+                                                session = configured
+                                                try {
+                                                    val request = device.createCaptureRequest(CameraDevice.TEMPLATE_PREVIEW).apply {
+                                                        addTarget(preview!!.surface)
+                                                        set(CaptureRequest.CONTROL_AF_MODE, CaptureRequest.CONTROL_AF_MODE_CONTINUOUS_PICTURE)
+                                                    }
+                                                    configured.setSingleRepeatingRequest(request.build(), executor,
+                                                        object : CameraCaptureSession.CaptureCallback() {
+                                                            override fun onCaptureCompleted(s: CameraCaptureSession, r: CaptureRequest, result: TotalCaptureResult) {
+                                                                if (finished || capturing) return
+                                                                frames++
+                                                                val ae = result[CaptureResult.CONTROL_AE_STATE]
+                                                                val af = result[CaptureResult.CONTROL_AF_STATE]
+                                                                if (frames < 3 || (frames < 30 && (ae == CaptureResult.CONTROL_AE_STATE_SEARCHING ||
+                                                                        af == CaptureResult.CONTROL_AF_STATE_PASSIVE_SCAN))) return
+                                                                capturing = true
+                                                                try {
+                                                                    val still = device.createCaptureRequest(CameraDevice.TEMPLATE_STILL_CAPTURE).apply {
+                                                                        addTarget(jpeg!!.surface)
+                                                                        set(REMOSAIC, true)
+                                                                        set(REMOSAIC_HINT, intArrayOf(1))
+                                                                        set(CaptureRequest.CONTROL_AF_MODE, CaptureRequest.CONTROL_AF_MODE_CONTINUOUS_PICTURE)
+                                                                        set(CaptureRequest.JPEG_ORIENTATION,
+                                                                            ((info[CameraCharacteristics.SENSOR_ORIENTATION] ?: 90) + orientation) % 360)
+                                                                        set(CaptureRequest.JPEG_QUALITY, 95.toByte())
+                                                                        output.metadata.location?.let { set(CaptureRequest.JPEG_GPS_LOCATION, it) }
+                                                                    }
+                                                                    configured.captureSingleRequest(still.build(), executor,
+                                                                        object : CameraCaptureSession.CaptureCallback() {
+                                                                            override fun onCaptureStarted(s: CameraCaptureSession, r: CaptureRequest, t: Long, n: Long) = onCaptureStarted()
+                                                                            override fun onCaptureFailed(s: CameraCaptureSession, r: CaptureRequest, failure: CaptureFailure) =
+                                                                                fail(IllegalStateException("Full-resolution capture failed: ${failure.reason}"))
+                                                                        })
+                                                                } catch (error: Exception) { fail(error) }
+                                                            }
+                                                        })
+                                                } catch (error: Exception) { fail(error) }
+                                            }
+                                            override fun onConfigureFailed(session: CameraCaptureSession) {
+                                                session.close()
+                                                fail(IllegalStateException("Full-resolution session rejected"))
+                                            }
+                                        }
+                                        device.createCaptureSession(SessionConfiguration(SESSION_HD,
+                                            listOf(OutputConfiguration(preview!!.surface), OutputConfiguration(jpeg!!.surface)),
+                                            executor, callback))
+                                    } catch (error: Exception) { fail(error) }
+                                }
+                                override fun onDisconnected(device: CameraDevice) {
+                                    camera = device
+                                    device.close()
+                                    fail(IllegalStateException("Camera disconnected"))
+                                }
+                                override fun onError(device: CameraDevice, error: Int) {
+                                    camera = device
+                                    device.close()
+                                    fail(IllegalStateException("Camera error $error"))
+                                }
+                                override fun onClosed(device: CameraDevice) { closed.complete(Unit) }
+                            }
+                            // CameraX unbind is asynchronous. Wait for its device to close before
+                            // asking the HAL for our private session, rather than racing openCamera.
+                            availability = object : CameraManager.AvailabilityCallback() {
+                                override fun onCameraAvailable(cameraId: String) {
+                                    if (cameraId != "0" || finished || openRequested) return
+                                    manager.unregisterAvailabilityCallback(this)
+                                    try {
+                                        openRequested = true
+                                        manager.openCamera("0", executor, deviceCallback)
+                                    } catch (error: Exception) {
+                                        closed.complete(Unit)
+                                        fail(error)
+                                    }
+                                }
+                            }
+                            manager.registerAvailabilityCallback(executor, availability!!)
+                        } catch (error: Exception) {
+                            // openCamera threw before a device could deliver onClosed.
+                            if (camera == null) closed.complete(Unit)
+                            fail(error)
+                        }
+                    }
+                }
+            }
+        } finally {
+            // Do not hand the camera back to CameraX until the HAL confirms close.
+            try {
+                withContext(NonCancellable) { withTimeout(5_000) { closed.await() } }
+            } catch (_: TimeoutCancellationException) {
+                // Distinguish failure to release the device from ordinary capture failure.
+                throw CameraCloseTimeoutException()
+            }
+        }
+        return withContext(Dispatchers.IO) {
+            output.outputStream?.let {
+                it.write(data)
+                return@withContext ImageCapture.OutputFileResults(null, ImageFormat.JPEG)
+            }
+            val resolver = checkNotNull(output.contentResolver)
+            val values = ContentValues(checkNotNull(output.contentValues)).apply {
+                put(MediaStore.Images.Media.IS_PENDING, 1)
+            }
+            val uri = checkNotNull(resolver.insert(checkNotNull(output.saveCollection), values))
+            try {
+                checkNotNull(resolver.openOutputStream(uri)).use { it.write(data) }
+                values.clear()
+                values.put(MediaStore.Images.Media.IS_PENDING, 0)
+                check(resolver.update(uri, values, null, null) == 1)
+                ImageCapture.OutputFileResults(uri, ImageFormat.JPEG)
+            } catch (error: Exception) {
+                resolver.delete(uri, null, null)
+                throw error
+            }
+        }
+    }
+}
