+    private static int parseTcpState(@NonNull ByteBuffer buffer) {
+        final StructNlAttr protoInfo = findNextAttrOfType(makeNestedType(CTA_PROTOINFO), buffer);
+        if (protoInfo == null) return TCP_CONNTRACK_UNKNOWN;
+        final ByteBuffer protoBuffer = protoInfo.getValueAsByteBuffer();
+        if (protoBuffer == null) return TCP_CONNTRACK_UNKNOWN;
+        final StructNlAttr tcp = findNextAttrOfType(makeNestedType(CTA_PROTOINFO_TCP), protoBuffer);
+        if (tcp == null) return TCP_CONNTRACK_UNKNOWN;
+        final ByteBuffer tcpBuffer = tcp.getValueAsByteBuffer();
+        if (tcpBuffer == null) return TCP_CONNTRACK_UNKNOWN;
+        final StructNlAttr state = findNextAttrOfType(CTA_PROTOINFO_TCP_STATE, tcpBuffer);
+        if (state == null || state.nla_value == null || state.nla_value.length != 1) {
+            return TCP_CONNTRACK_UNKNOWN;
+        }
+        return Byte.toUnsignedInt(state.getValueAsByte((byte) 0));
     }
 
