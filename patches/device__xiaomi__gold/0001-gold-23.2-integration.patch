diff --git a/sepolicy/vendor/file_contexts b/sepolicy/vendor/file_contexts
new file mode 100644
index 0000000..db866b3
--- /dev/null
+++ b/sepolicy/vendor/file_contexts
@@ -0,0 +1,3 @@
+# MiTEE services used by the gold vendor blobs.  Without explicit executable
+# labels, init refuses to start these services even when SELinux is permissive.
+/(vendor|system/vendor)/bin/hw/android\.hardware\.security\.keymint@1\.0-service\.mitee u:object_r:hal_keymint_default_exec:s0
