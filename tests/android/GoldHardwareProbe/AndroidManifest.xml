<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.gold.hardwareprobe" android:versionCode="1" android:versionName="1">
    <uses-sdk android:minSdkVersion="35" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <queries><package android:name="com.android.systemui" /></queries>
    <application android:label="Gold hardware probe" android:allowBackup="false"
        android:testOnly="true" android:debuggable="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".GoldAuthActivity" android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
