+/* Board opt-in only; a four-byte reply is not a WH success response. */
+static bool legacy_wh_handshake;
+module_param(legacy_wh_handshake, bool, 0400);
+MODULE_PARM_DESC(legacy_wh_handshake,
+	"Allow the gold legacy WFPM enable handshake (default off)");
+
+bool mddp_legacy_wh_layout(struct mddp_app_t *app)
+{
+	/* Reset announces memory before the first feature response arrives. */
+	return legacy_wh_handshake && app->type == MDDP_APP_TYPE_WH;
+}
+
+bool mddp_legacy_wh_handshake(struct mddp_app_t *app)
+{
+	u32 feature = READ_ONCE(app->feature);
+
+	return legacy_wh_handshake && app->type == MDDP_APP_TYPE_WH &&
+		(feature & ~MDDP_FEATURE_MDDP_WH) == 0x3;
+}
