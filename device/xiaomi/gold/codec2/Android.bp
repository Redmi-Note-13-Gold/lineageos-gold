// SPDX-License-Identifier: Apache-2.0
cc_binary {
    name: "android.hardware.media.c2-service.gold",
    stem: "android.hardware.media.c2-mediatek",
    vendor: true,
    relative_install_path: "hw",
    compile_multilib: "64",
    defaults: ["libcodec2-aidl-defaults"],
    srcs: ["service.cpp"],
    shared_libs: [
        "libavservices_minijail",
        "libbase",
        "libcodec2_mtk_c2store",
        "libcodec2_mtk_vdec",
        "libcodec2_mtk_venc",
        "liblog",
    ],
    required: ["gold-codec2-crash.policy"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

prebuilt_etc {
    name: "gold-codec2-crash.policy",
    vendor: true,
    sub_dir: "seccomp_policy",
    src: "gold-codec2-crash.policy",
}
