# The Global AIDL Codec2 service dropped the HIDL version from its filename.
# Reuse the MediaTek codec domain already defined by the source policy.
/(vendor|system/vendor)/bin/hw/android\.hardware\.media\.c2-mediatek u:object_r:mtk_hal_c2_exec:s0

# Keep restorecon consistent with the boost genfscon label.
/sys/devices/virtual/thermal/thermal_message/boost u:object_r:vendor_sysfs_thermal_boost:s0

# Extraction dereferences the stock mt6833 symlinks into these flat paths.
# Keep their original same-process graphics HAL labels.
/(vendor|system/vendor)/lib(64)?/lib(pq_sec|mml|aal_sec)\.so u:object_r:same_process_hal_file:s0

# The stock allocator module is loaded into graphics client processes.
/(vendor|system/vendor)/lib64/hw/android\.hardware\.graphics\.allocator-V2-mediatek\.so u:object_r:same_process_hal_file:s0

# Source HAL service names differ from the platform/MediaTek default names.
/(vendor|system/vendor)/bin/hw/android\.hardware\.power-service\.pixel-libperfmgr u:object_r:hal_power_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.sensors-service\.xiaomi-multihal u:object_r:hal_sensors_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.biometrics\.fingerprint-service\.xiaomi u:object_r:hal_fingerprint_default_exec:s0
/(vendor|system/vendor)/bin/hw/vendor\.qti\.hardware\.vibrator\.service\.gold u:object_r:hal_vibrator_default_exec:s0

# Keep restorecon consistent with the fingerprint genfscon labels.
/sys/devices/platform/fingerprint/(clk_enable|irq|hw_reset|wakeup_enable|fingerdown_wait) u:object_r:vendor_sysfs_fingerprint_control:s0

# The renamed stock Wi-Fi calibration loader retains its existing domain.
/(vendor|system/vendor)/bin/wlan_assistant-gold u:object_r:wlan_assistant_exec:s0

