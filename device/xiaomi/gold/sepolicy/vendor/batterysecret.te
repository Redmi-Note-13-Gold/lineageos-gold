type batterysecret, domain;
type batterysecret_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(batterysecret)
wakelock_use(batterysecret)

# The read-only PD status nodes retain their existing generic sysfs label.
# USB supply status retains sysfs_batteryinfo for Health and thermal readers.
r_dir_file(batterysecret, sysfs)
r_dir_file(batterysecret, sysfs_batteryinfo)
allow batterysecret vendor_gold_sysfs_usbpd:file { open read write getattr };
# The imported vendor init action chmods precisely these three leaves.
allow vendor_init vendor_gold_sysfs_usbpd:file setattr;

# The stock policy also lets the health reader inspect PD authentication
# status. Keep that read path after changing only the three control leaves.
r_dir_file(hal_health_default, vendor_gold_sysfs_usbpd)

# The binary opens data_role O_RDWR. MTK USB HAL already has read/write access
# to sysfs_usb_nonplat, so reuse that existing type only on this one leaf.
allow batterysecret sysfs_usb_nonplat:file { open read write getattr };

allow batterysecret self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
set_prop(batterysecret, vendor_gold_accelerate_charge_prop)
