# Hardware format capabilities read by the vendor EGL driver in app processes.
vendor_public_prop(vendor_arm_egl_config_prop)

# Vendor fingerprint module selection reported by the source HAL.
vendor_internal_prop(vendor_gold_fingerprint_prop)

# batterysecret reads and can set this one stock charging state property.
vendor_internal_prop(vendor_gold_accelerate_charge_prop)
